{
  "info": {
    "_postman_id": "b8a92f03-6250-482a-9297-c2560e202602",
    "name": "Proyecto 4: Clúster MySQL 8.0 & ProxySQL 2.x — Servicios Telemáticos UAO",
    "description": "Colección oficial de pruebas API REST y enrutamiento Capa 7 para el Proyecto Final de Servicios Telemáticos (2026-02). Valida el Read/Write Split en microservicio Flask conectado a ProxySQL (puerto 6033), cubriendo CRUD de Usuarios, CRUD de Productos, Telemetría IoT y Query Cache en RAM.\n\nAutores: Eduard Criollo Yule & Felipe Charria Caicedo\nDocente: Prof. Oscar Mondragón",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Salud del Clúster",
      "item": [
        {
          "name": "Healthcheck General",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Verifica que el microservicio Flask esté activo y conectado transparentemente al puerto 6033 de ProxySQL."
          }
        },
        {
          "name": "Estadísticas del Connection Pool de ProxySQL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cluster/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cluster", "stats"]
            },
            "description": "Consulta en tiempo real la base SQLite interna de ProxySQL (puerto 6032) para inspeccionar servidores activos, conexiones usadas/libres y digest de consultas."
          }
        }
      ]
    },
    {
      "name": "1. CRUD de Usuarios (Práctica 9)",
      "item": [
        {
          "name": "1.1 Listar Todos los Usuarios (Read Split -> HG 20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Enrutado transparentemente a las Réplicas en Hostgroup 20 (mysql-slave-1 o mysql-slave-2) sin tocar el Maestro."
          }
        },
        {
          "name": "1.2 Consultar Usuario por ID (Read Split -> HG 20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Consulta individual de usuario por clave primaria ID."
          }
        },
        {
          "name": "1.3 Crear Usuario (Write Split -> HG 10 Maestro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Benavides\",\n  \"email\": \"carlos.benavides@uao.edu.co\",\n  \"username\": \"cbenavides\",\n  \"password\": \"Ingenieria2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users"]
            },
            "description": "Inserta un nuevo registro transaccional en la tabla users. ProxySQL detecta la regla regex INSERT y enruta al Maestro (HG 10)."
          }
        },
        {
          "name": "1.4 Actualizar Usuario (Write Split -> HG 10 Maestro)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Carlos Benavides Modificado\",\n  \"email\": \"carlos.mod@uao.edu.co\",\n  \"username\": \"cbenavides_mod\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "1"]
            },
            "description": "Actualiza atributos del usuario en el Maestro garantizando aislamiento y transaccionalidad ACID."
          }
        },
        {
          "name": "1.5 Eliminar Usuario (Write Split -> HG 10 Maestro)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "users", "4"]
            },
            "description": "Elimina físicamente un usuario en el Maestro, propagando la eliminación a las réplicas mediante GTID Semi-Síncrono."
          }
        }
      ]
    },
    {
      "name": "2. CRUD de Productos (Práctica 9)",
      "item": [
        {
          "name": "2.1 Listar Catálogo de Productos (Read Split -> HG 20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Obtiene la lista completa de productos del inventario telemático balanceado entre mysql-slave-1 y mysql-slave-2."
          }
        },
        {
          "name": "2.2 Consultar Producto por ID (Read Split -> HG 20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Consulta de producto individual atendida por una de las réplicas."
          }
        },
        {
          "name": "2.3 Crear Producto (Write Split -> HG 10 Maestro)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Router Core Empresarial BGP\",\n  \"description\": \"Enrutador modular de borde 4x 10GbE SFP+\",\n  \"price\": 1450.00,\n  \"stock\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "description": "Crea un producto en el inventario. Enrutado exclusivamente a mysql-master (HG 10)."
          }
        },
        {
          "name": "2.4 Actualizar Producto (Write Split -> HG 10 Maestro)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Pro 15 M3\",\n  \"description\": \"Actualizada a 32GB RAM y 1TB NVMe\",\n  \"price\": 1390.00,\n  \"stock\": 12\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "1"]
            },
            "description": "Actualiza precio y stock del producto en el Maestro."
          }
        },
        {
          "name": "2.5 Eliminar Producto (Write Split -> HG 10 Maestro)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products/6",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "6"]
            },
            "description": "Elimina el producto del catálogo en el Maestro."
          }
        }
      ]
    },
    {
      "name": "3. Telemetría IoT & Query Cache",
      "item": [
        {
          "name": "3.1 Insertar Telemetría (Write Split -> HG 10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"UAO-POSTMAN-SENS\",\n  \"sensor_type\": \"humidity\",\n  \"metric_value\": 62.4,\n  \"unit\": \"%\",\n  \"location\": \"Datacenter Principal UAO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/telemetry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "telemetry"]
            },
            "description": "Inserta una lectura IoT en el Maestro."
          }
        },
        {
          "name": "3.2 Consultar Telemetría (Read Split -> HG 20)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/telemetry",
              "host": ["{{baseUrl}}"],
              "path": ["api", "telemetry"]
            },
            "description": "Consulta las últimas 10 lecturas registradas. Atendido por HG 20."
          }
        },
        {
          "name": "3.3 Consulta Acelerada con Query Cache en RAM",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/telemetry/cached",
              "host": ["{{baseUrl}}"],
              "path": ["api", "telemetry", "cached"]
            },
            "description": "Ejecuta SELECT con el hint /*+ CACHE */. ProxySQL sirve la respuesta desde su memoria RAM con latencia sub-milisegundo (TTL 5s) sin consultar los motores MySQL."
          }
        },
        {
          "name": "3.4 Ráfaga de Estrés y Multiplexing Concurrente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reads\": 30,\n  \"writes\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cluster/burst",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cluster", "burst"]
            },
            "description": "Dispara 35 consultas en ráfaga para verificar el multiplexing de conexiones y la distribución de carga."
          }
        }
      ]
    }
  ]
}
