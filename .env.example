# ==============================================================================
# PROYECTO 4: BALANCEO DE CARGAS MYSQL CON PROXYSQL
# Servicios Telemáticos — Universidad Autónoma de Occidente (2026-02)
# ==============================================================================

# Versiones de Imágenes Docker
MYSQL_IMAGE=mysql:8.0
PROXYSQL_IMAGE=proxysql/proxysql:2.6.3
PYTHON_IMAGE=python:3.11-slim

# Puertos Expuestos en el Host (Aislamiento de puerto 3306)
PROXYSQL_MYSQL_PORT=6033
PROXYSQL_ADMIN_PORT=6032
FLASK_PORT=5000

# Base de Datos y Credenciales de Aplicación
MYSQL_DATABASE=telematicos_db
MYSQL_ROOT_PASSWORD=RootPasswordTelematicos2026!
MYSQL_APP_USER=cluster_app
MYSQL_APP_PASSWORD=AppPassword2026!

# Credenciales de Replicación GTID
MYSQL_REPL_USER=repl_user
MYSQL_REPL_PASSWORD=ReplPassword2026!

# Credenciales de Monitoreo ProxySQL
MYSQL_MONITOR_USER=monitor
MYSQL_MONITOR_PASSWORD=MonitorPassword2026!

# Credenciales de Administración ProxySQL (SQLite Interface)
PROXYSQL_ADMIN_USER=admin
PROXYSQL_ADMIN_PASSWORD=admin

# Parámetros Oficiales de Benchmark Sysbench (Prueba 3)
SYSBENCH_TABLES=1
SYSBENCH_TABLE_SIZE=1000000
SYSBENCH_THREADS=16
SYSBENCH_TIME=120
